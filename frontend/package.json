  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "esbuild": "0.28.2",
    "ipaddr.js": "2.5.0",
    "maxmind": "5.0.7",
    "prettier": "^3.9.9",
    "vite": "^6.1.0",
    "vite-plugin-singlefile": "^2.2.0"
  }
}
