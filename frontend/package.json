{
  "name": "workbuddy-console",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:geo": "node scripts/build-geo.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/publish.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write src scripts tests *.js *.json index.html",
    "preview": "vite preview --host 127.0.0.1",
    "fixture": "node tests/fixture-server.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
